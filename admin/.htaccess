# ============================================================
# Admin directory protection
# admin/.htaccess
# ============================================================

Options -Indexes

# Block all direct access — PHP handles session auth
# Uncomment the block below to add an extra IP whitelist layer:
# <IfModule mod_authz_core.c>
#   Require ip 123.456.789.0/24
#   Require ip 127.0.0.1
# </IfModule>

# Deny access to any non-PHP file
<FilesMatch "^(?!.*\.php$).*$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Security headers for admin pages
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
